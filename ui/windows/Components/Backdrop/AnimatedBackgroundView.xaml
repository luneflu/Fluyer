<UserControl
    x:Class="Fluyer.Components.AnimatedBackgroundView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Animated, blurred artwork backdrop behind the whole window. GPU path is a
         D3D11 port of macOS ArtworkBackdropRenderer (three spinning artwork
         instances, Kawase blur, warp mesh), presented through a staging
         readback; the static bitmap underneath shows while the GPU warms up
         and when Direct3D is unavailable. -->
    <Grid Background="Black">
        <Image
            x:Name="Backdrop"
            Stretch="UniformToFill"
            Opacity="0.85"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
