<UserControl
    x:Class="Fluyer.Components.SliderTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Draggable capsule slider for position and volume. Port of SliderTrack
         (ui/macos/Sources/Components/SliderTrack.swift). -->
    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="Back"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="#2EFFFFFF" />
        <Border
            x:Name="Front"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#E6FFFFFF" />
    </Grid>
</UserControl>
