<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Fluyer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluyer"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Shared/Theme/Layout.xaml" />
                <ResourceDictionary Source="ms-appx:///Shared/Theme/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="{StaticResource IconButtonPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource IconButtonCornerRadius}" />
            </Style>
            <!-- Icon-only toggle (title-bar queue button): flat until checked; checked colors come from Colors.xaml. -->
            <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="{StaticResource IconButtonPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource IconButtonCornerRadius}" />
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
