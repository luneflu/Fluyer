<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Every padding, spacing, size and corner radius in the app, grouped by the UI
        part it belongs to. Search the feature name ("Queue", "PlayerBar") to land here.
        Windows twin of ui/macos/Sources/Shared/Theme/Layout.swift.

        Key = <Feature><Role>. Names say what a value is for, not what it is, so two
        parts that happen to share a number stay independent. Font sizes, opacities,
        timings stay with their views. Code-behind reads these through Layout.cs.
    -->

    <!-- Window shell (MainWindow) -->
    <x:Double x:Key="WindowInitialWidth">1050</x:Double>
    <x:Double x:Key="WindowInitialHeight">720</x:Double>
    <GridLength x:Key="WindowTitleBarHeight">48</GridLength>
    <!-- One horizontal gutter for every library component; sidebars use the same 16 from the window edge. -->
    <Thickness x:Key="WindowPageGutter">16,0</Thickness>
    <x:Double x:Key="WindowToolbarSpacing">6</x:Double>
    <!-- Gap between the toolbar and the window buttons. -->
    <Thickness x:Key="WindowToolbarMargin">0,0,8,0</Thickness>
    <x:Double x:Key="WindowSearchFieldWidth">240</x:Double>
    <x:Double x:Key="WindowScanProgressSpacing">6</x:Double>
    <x:Double x:Key="WindowScanProgressWidth">120</x:Double>

    <!-- Icon buttons everywhere (IconButtonStyle in App.xaml) -->
    <Thickness x:Key="IconButtonPadding">6,4</Thickness>
    <CornerRadius x:Key="IconButtonCornerRadius">6</CornerRadius>

    <!-- Album strip (AlbumCarouselView, AlbumCard template).
         Card gap = AlbumsItemMargin.Right; code reads it for slot math. -->
    <CornerRadius x:Key="AlbumsCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="AlbumsItemPadding">8,6,8,6</Thickness>
    <Thickness x:Key="AlbumsItemMargin">0,0,16,0</Thickness>
    <x:Double x:Key="AlbumsCoverToLabels">5</x:Double>
    <x:Double x:Key="AlbumsNameToArtist">2</x:Double>
    <x:Double x:Key="AlbumsLabelHeight">52</x:Double>
    <!-- Albums mode grid (AlbumGridView); side gutter comes from WindowPageGutter. -->
    <Thickness x:Key="AlbumsGridPadding">0,8</Thickness>
    <!-- Right = -(AlbumsGridItemMargin.Right): cancels the last column's gap. -->
    <Thickness x:Key="AlbumsGridMargin">0,0,-16,0</Thickness>
    <Thickness x:Key="AlbumsGridItemMargin">0,0,16,16</Thickness>

    <!-- Toolbar sort button + Songs/Albums switch (SortMenu, MainWindow title bar) -->
    <x:Double x:Key="ToolbarModeButtonWidth">36</x:Double>
    <!-- Default button padding (11 per side) leaves too little room for the icon. -->
    <Thickness x:Key="ToolbarModeButtonPadding">0,5,0,6</Thickness>

    <!-- Album title strip (AlbumHeaderView) -->
    <x:Double x:Key="AlbumHeaderHeight">46</x:Double>
    <Thickness x:Key="AlbumHeaderMargin">0,4,0,0</Thickness>
    <Thickness x:Key="AlbumHeaderPadding">16,0</Thickness>
    <CornerRadius x:Key="AlbumHeaderCornerRadius">8</CornerRadius>
    <x:Double x:Key="AlbumHeaderButtonSpacing">8</x:Double>

    <!-- Song grid (MusicGridView). Column gap = MusicGridItemMargin.Right;
         MusicGridListMargin.Right must be its negative (cancels the last column's gap). -->
    <CornerRadius x:Key="MusicGridCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="MusicGridListMargin">0,0,-16,0</Thickness>
    <Thickness x:Key="MusicGridItemPadding">8,6,12,6</Thickness>
    <Thickness x:Key="MusicGridItemMargin">0,0,16,16</Thickness>
    <x:Double x:Key="MusicGridMinColumnWidth">280</x:Double>
    <x:Double x:Key="MusicGridEmptyStateSpacing">12</x:Double>

    <!-- One song row (TrackCard template in MusicGridView) -->
    <x:Double x:Key="TrackRowCoverSide">44</x:Double>
    <!-- Requested cover pixels (2x for HiDPI). -->
    <x:Double x:Key="TrackRowCoverPixels">88</x:Double>
    <x:Double x:Key="TrackRowCoverToText">10</x:Double>
    <x:Double x:Key="TrackRowTitleToSubtitle">2</x:Double>
    <x:Double x:Key="TrackRowIconToTitle">6</x:Double>

    <!-- Right sidebar, "Queue" (QueueView) -->
    <Thickness x:Key="QueueOuterMargin">0,4,16,16</Thickness>
    <Thickness x:Key="QueuePadding">12</Thickness>
    <CornerRadius x:Key="QueueCornerRadius">0</CornerRadius>
    <x:Double x:Key="QueueHeaderToList">8</x:Double>
    <x:Double x:Key="QueueHeaderSpacing">6</x:Double>
    <Thickness x:Key="QueueTitleMargin">8,12,0,8</Thickness>
    <Thickness x:Key="QueueRowPadding">0,4</Thickness>
    <x:Double x:Key="QueueRowTextToButtons">6</x:Double>
    <x:Double x:Key="QueueRowTitleToArtist">2</x:Double>

    <!-- Bottom player bar (PlayerBarView) -->
    <x:Double x:Key="PlayerBarSeekToControls">6</x:Double>
    <x:Double x:Key="PlayerBarSeekHeight">6</x:Double>
    <Thickness x:Key="PlayerBarControlsMargin">0,0,0,10</Thickness>
    <Thickness x:Key="PlayerBarControlsPadding">18,0</Thickness>
    <CornerRadius x:Key="PlayerBarCornerRadius">26</CornerRadius>
    <x:Double x:Key="PlayerBarControlsHeight">52</x:Double>
    <GridLength x:Key="PlayerBarSideColumnWidth">220</GridLength>
    <x:Double x:Key="PlayerBarTransportSpacing">12</x:Double>
    <x:Double x:Key="PlayerBarCoverToText">10</x:Double>
    <x:Double x:Key="PlayerBarCoverSide">40</x:Double>
    <x:Double x:Key="PlayerBarTitleToArtist">2</x:Double>
    <x:Double x:Key="PlayerBarSecondarySpacing">10</x:Double>
    <x:Double x:Key="PlayerBarVolumeSliderWidth">80</x:Double>
    <x:Double x:Key="PlayerBarVolumeSliderHeight">24</x:Double>

    <!-- Full-screen player (PlayView): columns, cover, back button -->
    <GridLength x:Key="PlayLyricsColumnWidth">1.375*</GridLength>
    <x:Double x:Key="PlayCoverToControls">16</x:Double>
    <x:Double x:Key="PlayInitialCoverSide">300</x:Double>
    <x:Double x:Key="PlayMinCoverSide">200</x:Double>
    <x:Double x:Key="PlayMaxCoverSide">360</x:Double>
    <!-- Gap between the cover column and lyrics; also subtracted from the column for the cover side. -->
    <x:Double x:Key="PlayColumnGutter">40</x:Double>
    <x:Double x:Key="PlayCoverColumnRatio">0.40</x:Double>
    <x:Double x:Key="PlayCenteredColumnRatio">0.50</x:Double>
    <Thickness x:Key="PlayBackButtonMargin">12,24,0,0</Thickness>

    <!-- Play screen controls card (PlayView control card) -->
    <Thickness x:Key="PlayControlsInfoMargin">0,4,0,12</Thickness>
    <x:Double x:Key="PlayControlsInfoSpacing">10</x:Double>
    <GridLength x:Key="PlayControlsTimeLabelWidth">48</GridLength>
    <x:Double x:Key="PlayControlsSeekHeight">8</x:Double>
    <Thickness x:Key="PlayControlsTransportMargin">0,20,0,0</Thickness>
    <x:Double x:Key="PlayControlsTransportSpacing">8</x:Double>
    <Thickness x:Key="PlayControlsVolumeMargin">0,8,0,0</Thickness>
    <x:Double x:Key="PlayControlsVolumeSpacing">12</x:Double>
    <x:Double x:Key="PlayControlsVolumeSliderHeight">14</x:Double>

    <!-- Lyrics column (PlayView lyrics list). Vertical padding lets the first/last
         line scroll to the viewport center. -->
    <Thickness x:Key="LyricsPadding">28,260,28,260</Thickness>
    <Thickness x:Key="LyricsLineMargin">0,20</Thickness>

    <!-- Slider (SliderTrack): bar thickness, normal / hovered -->
    <x:Double x:Key="SliderThickness">5</x:Double>
    <x:Double x:Key="SliderThicknessHovered">6</x:Double>
    <x:Double x:Key="SliderThinThickness">4</x:Double>
    <x:Double x:Key="SliderThinThicknessHovered">5</x:Double>

    <!-- Toast (ToastView) -->
    <Thickness x:Key="ToastMargin">0,0,0,80</Thickness>
    <Thickness x:Key="ToastPadding">16,10</Thickness>
    <CornerRadius x:Key="ToastCornerRadius">17</CornerRadius>

    <!-- Settings dialog (SettingsView) -->
    <x:Double x:Key="SettingsWidth">440</x:Double>
    <x:Double x:Key="SettingsSectionSpacing">16</x:Double>
    <x:Double x:Key="SettingsRowSpacing">8</x:Double>
    <x:Double x:Key="SettingsFolderListMaxHeight">220</x:Double>
</ResourceDictionary>
