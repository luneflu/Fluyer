<UserControl
    x:Class="Fluyer.Views.PlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fluyer.Controls"
    xmlns:native="using:Fluyer.Core.Native"
    xmlns:views="using:Fluyer.Views">
    <!-- Full-screen now-playing surface. Port of PlayView
         (ui/macos/Sources/Views/Play/PlayView.swift): cover + control card on
         the left, lyrics scroller on the right when lyrics exist. -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="LyricsColumn" Width="1.375*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: cover + control card -->
        <StackPanel
            x:Name="LeftStack"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <views:CurrentCoverView x:Name="Cover" Side="300" State="{x:Bind State, Mode=OneWay}" />
            <StackPanel x:Name="ControlCard" Spacing="0">
                <Grid Margin="0,4,0,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.75"
                        Text="{x:Bind TimeFormatElapsed(State.Playback.PlayerBar.PositionMs), Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        Opacity="0.9"
                        Text="{x:Bind TrackLabel(State.Playback.PlayerBar), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.75"
                        Text="{x:Bind TimeFormatElapsed(State.Playback.PlayerBar.DurationMs), Mode=OneWay}" />
                </Grid>

                <controls:SliderTrack
                    x:Name="Progress"
                    Height="8"
                    Fraction="{x:Bind State.Playback.PlayerBar.ProgressPct, Mode=OneWay}" />

                <StackPanel
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="OnCycleRepeat"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Repeat">
                        <FontIcon x:Name="RepeatIcon" FontSize="15" Glyph="&#xE8EE;" />
                    </Button>
                    <Button
                        Click="OnPrevious"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Previous">
                        <FontIcon FontSize="18" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        Click="OnTogglePlay"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Play/Pause">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="24" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Click="OnNext"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Next">
                        <FontIcon FontSize="18" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        Click="OnShuffle"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Shuffle">
                        <FontIcon x:Name="ShuffleIcon" FontSize="15" Glyph="&#xE8B1;" />
                    </Button>
                </StackPanel>

                <Grid Margin="0,8,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="OnToggleMute"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Mute/Unmute">
                        <FontIcon FontSize="13" Glyph="&#xE74F;" />
                    </Button>
                    <controls:SliderTrack
                        x:Name="Volume"
                        Grid.Column="1"
                        Height="14"
                        IsThin="True"
                        Fraction="{x:Bind State.Playback.PlayerBar.Volume, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Click="OnMaxVolume"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Max volume">
                        <FontIcon x:Name="VolumeIcon" FontSize="13" Glyph="&#xE995;" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Lyrics column -->
        <ListView
            x:Name="Lyrics"
            Grid.Column="1"
            IsItemClickEnabled="True"
            ItemClick="OnLyricClick"
            ItemsSource="{x:Bind State.Playback.PlayView.Lyrics, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="native:LyricLine">
                    <TextBlock
                        Margin="0,20"
                        FontSize="25"
                        FontWeight="Bold"
                        Opacity="0.4"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Back -->
        <Button
            x:Name="BackButton"
            Margin="12,24,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="OnBack"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Back (Esc)">
            <FontIcon FontSize="13" Glyph="&#xE76B;" />
        </Button>
    </Grid>
</UserControl>
