<UserControl
    x:Class="Fluyer.Views.CollectionHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Album title strip + actions. Port of CollectionHeaderView
         (ui/macos/Sources/Views/Album/CollectionHeaderView.swift). -->
    <Border
        Height="46"
        Margin="0,4,0,0"
        Padding="16,0"
        Background="#14FFFFFF"
        BorderBrush="#1FFFFFFF"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                MaxLines="1"
                Text="{x:Bind State.Selection.Detail.Subtitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="OnBack"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Back to Albums">
                    <FontIcon FontSize="13" Glyph="&#xE76B;" />
                </Button>
                <Button
                    Click="OnPlay"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Play Album">
                    <FontIcon FontSize="13" Glyph="&#xE768;" />
                </Button>
                <Button
                    Click="OnQueue"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Add to Queue">
                    <FontIcon FontSize="13" Glyph="&#xE8F2;" />
                </Button>
                <Button
                    Click="OnShuffle"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Shuffle Album">
                    <FontIcon FontSize="13" Glyph="&#xE8B1;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
