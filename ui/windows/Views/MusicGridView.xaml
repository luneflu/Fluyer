<UserControl
    x:Class="Fluyer.Views.MusicGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native"
    xmlns:views="using:Fluyer.Views">
    <!-- Track rows for the whole library or one album. Port of MusicGridView
         (ui/macos/Sources/Views/Library/MusicGridView.swift). -->
    <Grid>
        <ListView
            x:Name="Rows"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind State.Selection.DisplayedTracks, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="native:TrackItemViewModel">
                    <Grid Padding="0,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44">
                            <Rectangle Fill="#14FFFFFF" />
                            <FontIcon
                                FontSize="16"
                                Foreground="#4DFFFFFF"
                                Glyph="&#xE8D2;"
                                Tag="art" />
                            <Image x:Name="Thumb" Stretch="UniformToFill" Opacity="0" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    x:Name="NowPlaying"
                                    FontSize="10"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE993;"
                                    Tag="now"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="1"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                MaxLines="1"
                                Opacity="0.6"
                                Text="{x:Bind views:MusicGridView.ArtistAlbumLine(Artist, Album)}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Opacity="0.4"
                            Text="{x:Bind DurationFormatted}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="36"
                Foreground="#33FFFFFF"
                Glyph="&#xE8D2;" />
            <TextBlock
                x:Name="EmptyLabel"
                FontSize="14"
                Opacity="0.5"
                Text="No songs in library" />
            <Button
                x:Name="EmptyAction"
                HorizontalAlignment="Center"
                Click="OnOpenFolder"
                Content="Open Music Folder..."
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
