<UserControl
    x:Class="Fluyer.Views.AlbumCarouselView"
    x:Name="CarouselRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native">
    <!-- Horizontal album strip. Port of AlbumCarouselView
         (ui/macos/Sources/Views/Album/AlbumCarouselView.swift), including the
         responsive width rules transcribed from AlbumListCtrl. -->
    <UserControl.Resources>
        <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
    </UserControl.Resources>
    <!-- Fluent ListViewItemPresenter insets its hover backplate ~4px horizontally
         and ~2px vertically. List padding 12 + backplate inset 4 = 16 gutter,
         matching player bar / header / grid. Item padding 12,10 leaves an 8px
         hover inset around the card. -->
    <ListView
        x:Name="Strip"
        Height="{Binding CarouselHeight, ElementName=CarouselRoot}"
        Padding="12,4"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind State.Library.Albums, Mode=OneWay}"
        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
        ScrollViewer.HorizontalScrollMode="Enabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollMode="Disabled"
        SelectionMode="None">
        <!-- Same as rows: no entrance replay on ItemsSource/metric resets. -->
        <ListView.ItemContainerTransitions>
            <TransitionCollection />
        </ListView.ItemContainerTransitions>
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="native:AlbumCardViewModel">
                <StackPanel Width="{Binding CardCoverSize, ElementName=CarouselRoot}" Spacing="5">
                    <Grid
                        Width="{Binding CardCoverSize, ElementName=CarouselRoot}"
                        Height="{Binding CardCoverSize, ElementName=CarouselRoot}">
                        <Rectangle Fill="#14FFFFFF" />
                        <FontIcon
                            FontSize="32"
                            Foreground="#4DFFFFFF"
                            Glyph="&#xEC4F;"
                            Tag="art" />
                        <Image x:Name="Cover" Stretch="UniformToFill" Opacity="0" />
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="13"
                            MaxLines="1"
                            Tag="albumtitle"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            MaxLines="1"
                            Opacity="0.6"
                            Text="{x:Bind Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
