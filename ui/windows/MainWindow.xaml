<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Fluyer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Fluyer.Views"
    Title="Fluyer"
    mc:Ignorable="d">
    <!-- Library window shell. Port of ContentView
         (ui/macos/Sources/Views/Library/ContentView.swift). -->
    <Grid>
        <views:AnimatedBackgroundView State="{x:Bind State, Mode=OneWay}" />

        <Grid x:Name="LibraryRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar" Title="Fluyer">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search songs"
                        PlaceholderText="Search title, artist, album"
                        QueryIcon="Find"
                        TextChanged="OnSearchChanged" />
                    <StackPanel
                        x:Name="ScanStatus"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressBar
                            Width="120"
                            IsIndeterminate="True"
                            ShowPaused="False" />
                        <TextBlock
                            x:Name="ScanLabel"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.7" />
                    </StackPanel>
                    <Button
                        AutomationProperties.Name="Settings"
                        Click="OnOpenSettings"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </TitleBar>

            <views:AlbumCarouselView
                Grid.Row="1"
                State="{x:Bind State, Mode=OneWay}" />

            <views:CollectionHeaderView
                x:Name="CollectionHeader"
                Grid.Row="2"
                State="{x:Bind State, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:MusicGridView
                x:Name="MusicGrid"
                Grid.Row="3"
                State="{x:Bind State, Mode=OneWay}" />

            <views:PlayerBarView
                Grid.Row="4"
                State="{x:Bind State, Mode=OneWay}" />
        </Grid>

        <views:PlayView
            x:Name="NowPlaying"
            State="{x:Bind State, Mode=OneWay}"
            Visibility="Collapsed" />

        <Border
            x:Name="Toast"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,80"
            Padding="16,10"
            Background="#333333"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="17"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ToastText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White" />
        </Border>

        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Done"
            DefaultButton="Close">
            <StackPanel Width="440" Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Music folders" />
                    <ListView
                        x:Name="FolderList"
                        MaxHeight="220"
                        ItemsSource="{x:Bind State.Settings.MusicFolders, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind}" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Remove folder"
                                        Click="OnRemoveFolder"
                                        Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Remove folder and its songs">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="NoFolders"
                        Opacity="0.6"
                        Text="No folders yet."
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnOpenFolder" Content="Add folder..." />
                        <Button x:Name="RescanButton" Click="OnRescan" Content="Rescan" />
                    </StackPanel>
                </StackPanel>
                <ToggleSwitch
                    Header="Animated background"
                    IsOn="{x:Bind State.Settings.AnimatedBackground, Mode=TwoWay}" />
                <ToggleSwitch
                    Header="Discord Rich Presence"
                    IsOn="{x:Bind State.Settings.DiscordRpc, Mode=TwoWay}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
