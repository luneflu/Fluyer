<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Fluyer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:Fluyer.Components"
    xmlns:screens="using:Fluyer.Screens"
    Title="Fluyer"
    mc:Ignorable="d">
    <!-- Library window shell. Port of HomeView
         (ui/macos/Sources/Screens/Home/HomeView.swift). -->
    <Grid>
        <components:AnimatedBackgroundView
            Covers="{x:Bind Covers}"
            Playback="{x:Bind State.Playback}"
            Settings="{x:Bind State.Settings}" />

        <Grid
            x:Name="LibraryRoot"
            KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource WindowTitleBarHeight}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar">
                <!-- Same commands as the macOS menu bar (ui/macos/Sources/App/FluyerApp.swift .commands). -->
                <TitleBar.LeftHeader>
                    <MenuBar>
                        <MenuBarItem Title="File">
                            <MenuFlyoutItem Click="OnOpenFolder" Text="Open Music Folder...">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnOpenSettings" Text="Settings..." />
                        </MenuBarItem>
                        <MenuBarItem Title="Playback">
                            <MenuFlyoutItem x:Name="PlayAllItem" Click="OnPlayAll" Text="Play All" />
                            <MenuFlyoutItem x:Name="PlayPauseItem" Click="OnTogglePlay" Text="Play" />
                            <MenuFlyoutItem Click="OnNext" Text="Next">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Right" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnPrevious" Text="Previous">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Left" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OnShowPlayScreen" Text="Show Play Screen">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="P" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem Title="View">
                            <MenuFlyoutItem Click="OnShowSongs" Text="Songs">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="OnShowAlbums" Text="Albums">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="QueueItem" Click="OnToggleQueue" Text="Show Queue">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                    </MenuBar>
                </TitleBar.LeftHeader>
                <!-- Toolbar sits at the trailing edge, next to the window buttons, in the
                     macOS order: scan progress, Songs/Albums, sort, search. -->
                <TitleBar.RightHeader>
                    <StackPanel
                        Margin="{StaticResource WindowToolbarMargin}"
                        Orientation="Horizontal"
                        Spacing="{StaticResource WindowToolbarSpacing}">
                        <StackPanel
                            x:Name="ScanStatus"
                            Orientation="Horizontal"
                            Spacing="{StaticResource WindowScanProgressSpacing}"
                            Visibility="Collapsed">
                            <ProgressBar
                                Width="{StaticResource WindowScanProgressWidth}"
                                IsIndeterminate="True"
                                ShowPaused="False" />
                            <TextBlock
                                x:Name="ScanLabel"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.7" />
                        </StackPanel>
                        <!-- Songs / Albums switch (macOS segmented "View" picker). -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton
                                x:Name="SongsMode"
                                Width="{StaticResource ToolbarModeButtonWidth}"
                                Padding="{StaticResource ToolbarModeButtonPadding}"
                                AutomationProperties.Name="Songs"
                                Click="OnShowSongs"
                                CornerRadius="4,0,0,4"
                                ToolTipService.ToolTip="Songs (Ctrl+1)">
                                <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="AlbumsMode"
                                Width="{StaticResource ToolbarModeButtonWidth}"
                                Padding="{StaticResource ToolbarModeButtonPadding}"
                                AutomationProperties.Name="Albums"
                                Click="OnShowAlbums"
                                CornerRadius="0,4,4,0"
                                ToolTipService.ToolTip="Albums (Ctrl+2)">
                                <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                            </ToggleButton>
                        </StackPanel>
                        <screens:SortMenu
                            VerticalAlignment="Center"
                            Filter="{x:Bind State.Selection}"
                            Style="{StaticResource IconButtonStyle}" />
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Width="{StaticResource WindowSearchFieldWidth}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Search songs"
                            PlaceholderText="Search title, artist, album"
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged" />
                        <ToggleButton
                            x:Name="QueueToggle"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Show Queue"
                            Click="OnToggleQueue"
                            Style="{StaticResource IconToggleButtonStyle}"
                            ToolTipService.ToolTip="Queue (Ctrl+L)">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </ToggleButton>
                    </StackPanel>
                </TitleBar.RightHeader>
            </TitleBar>

            <!-- Queue pane width follows the carousel: two album slots, like Sidebar.svelte. -->
            <SplitView
                x:Name="QueuePane"
                Grid.Row="1"
                Grid.RowSpan="3"
                SizeChanged="OnPaneHostSizeChanged"
                DisplayMode="Overlay"
                PaneBackground="Transparent"
                PaneClosed="OnQueuePaneClosed"
                PaneOpening="OnQueuePaneOpening"
                PanePlacement="Right">
                <SplitView.Pane>
                    <screens:QueueView Queue="{x:Bind State.Queue}" Library="{x:Bind State.Library}" Covers="{x:Bind Covers}" />
                </SplitView.Pane>
                <Grid Margin="{StaticResource WindowPageGutter}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <screens:AlbumGridView
                        x:Name="AlbumGrid"
                        Grid.RowSpan="3"
                        Covers="{x:Bind Covers}"
                        Filter="{x:Bind State.Selection}"
                        Library="{x:Bind State.Library}"
                        Visibility="Collapsed" />

                    <screens:AlbumCarouselView
                        x:Name="Carousel"
                        Covers="{x:Bind Covers}"
                        Filter="{x:Bind State.Selection}"
                        Library="{x:Bind State.Library}" />

                    <screens:AlbumHeaderView
                        x:Name="AlbumHeader"
                        Grid.Row="1"
                        Filter="{x:Bind State.Selection}"
                        Visibility="Collapsed" />

                    <screens:MusicGridView
                        x:Name="MusicGrid"
                        Grid.Row="2"
                        Covers="{x:Bind Covers}"
                        Filter="{x:Bind State.Selection}"
                        Library="{x:Bind State.Library}" />
                </Grid>
            </SplitView>

            <screens:PlayerBarView
                x:Name="PlayerBar"
                Grid.Row="4"
                Margin="{StaticResource WindowPageGutter}"
                Covers="{x:Bind Covers}"
                Playback="{x:Bind State.Playback}" />
        </Grid>

        <screens:PlayView
            x:Name="NowPlaying"
            Covers="{x:Bind Covers}"
            Playback="{x:Bind State.Playback}"
            Visibility="Collapsed" />

        <components:ToastView Toast="{x:Bind State.Toast}" />

        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Done"
            DefaultButton="Close">
            <screens:SettingsView x:Name="Settings" />
        </ContentDialog>
    </Grid>
</Window>
