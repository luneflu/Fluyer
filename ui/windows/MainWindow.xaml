<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Fluyer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Fluyer.Views"
    Title="Fluyer"
    mc:Ignorable="d">
    <!-- Library window shell. Port of ContentView
         (ui/macos/Sources/Views/Library/ContentView.swift). -->
    <Grid>
        <views:AnimatedBackgroundView State="{x:Bind State, Mode=OneWay}" />

        <Grid x:Name="LibraryRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar" Title="Fluyer">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search songs"
                        PlaceholderText="Search title, artist, album"
                        QueryIcon="Find"
                        TextChanged="OnSearchChanged" />
                    <StackPanel
                        x:Name="ScanStatus"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <ProgressBar
                            Width="120"
                            IsIndeterminate="True"
                            ShowPaused="False" />
                        <TextBlock
                            x:Name="ScanLabel"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.7" />
                    </StackPanel>
                    <Button
                        x:Name="OpenFolderButton"
                        Click="OnOpenFolder"
                        Content="Open Music Folder..."
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Open Music Folder" />
                </StackPanel>
            </TitleBar>

            <views:AlbumCarouselView
                Grid.Row="1"
                State="{x:Bind State, Mode=OneWay}" />

            <views:CollectionHeaderView
                x:Name="CollectionHeader"
                Grid.Row="2"
                State="{x:Bind State, Mode=OneWay}"
                Visibility="Collapsed" />

            <views:MusicGridView
                x:Name="MusicGrid"
                Grid.Row="3"
                State="{x:Bind State, Mode=OneWay}" />

            <views:PlayerBarView
                Grid.Row="4"
                State="{x:Bind State, Mode=OneWay}" />
        </Grid>

        <views:PlayView
            x:Name="NowPlaying"
            State="{x:Bind State, Mode=OneWay}"
            Visibility="Collapsed" />

        <Border
            x:Name="Toast"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,80"
            Padding="16,10"
            Background="#333333"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="17"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ToastText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White" />
        </Border>
    </Grid>
</Window>
