<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Fluyer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:Fluyer.Components"
    xmlns:screens="using:Fluyer.Screens"
    Title="Fluyer"
    mc:Ignorable="d">
    <!-- Library window shell. Port of HomeView
         (ui/macos/Sources/Screens/Home/HomeView.swift). -->
    <Grid>
        <components:AnimatedBackgroundView
            Covers="{x:Bind Covers}"
            Playback="{x:Bind State.Playback}"
            Settings="{x:Bind State.Settings}" />

        <Grid
            x:Name="LibraryRoot"
            KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource WindowTitleBarHeight}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="OnMenuToggle">
                <TitleBar.Resources>
                    <Style x:Key="TitleBarPaneToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarPaneToggleButtonStyle}">
                        <Setter Property="Margin" Value="{StaticResource WindowPaneButtonMargin}" />
                        <Setter Property="CornerRadius" Value="{StaticResource WindowPaneButtonCornerRadius}" />
                    </Style>
                </TitleBar.Resources>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource WindowToolbarSpacing}">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="{StaticResource WindowSearchFieldWidth}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search songs"
                        PlaceholderText="Search title, artist, album"
                        QueryIcon="Find"
                        TextChanged="OnSearchChanged" />
                    <StackPanel
                        x:Name="ScanStatus"
                        Orientation="Horizontal"
                        Spacing="{StaticResource WindowScanProgressSpacing}"
                        Visibility="Collapsed">
                        <ProgressBar
                            Width="{StaticResource WindowScanProgressWidth}"
                            IsIndeterminate="True"
                            ShowPaused="False" />
                        <TextBlock
                            x:Name="ScanLabel"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.7" />
                    </StackPanel>
                    <Button
                        AutomationProperties.Name="Settings"
                        Click="OnOpenSettings"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </TitleBar>

            <!-- Pane widths follow the carousel: two album slots, like Sidebar.svelte. -->
            <SplitView
                x:Name="MenuPane"
                Grid.Row="1"
                Grid.RowSpan="3"
                DisplayMode="Overlay"
                PaneBackground="Transparent"
                PanePlacement="Left"
                SizeChanged="OnPaneHostSizeChanged">
                <SplitView.Pane>
                    <screens:MenuView
                        x:Name="MenuPaneContent"
                        Library="{x:Bind State.Library}"
                        Playback="{x:Bind State.Playback}" />
                </SplitView.Pane>
                <SplitView
                    x:Name="QueuePane"
                    DisplayMode="Overlay"
                    PaneBackground="Transparent"
                    PaneClosed="OnQueuePaneClosed"
                    PaneOpening="OnQueuePaneOpening"
                    PanePlacement="Right">
                    <SplitView.Pane>
                        <screens:QueueView Queue="{x:Bind State.Queue}" />
                    </SplitView.Pane>
                    <Grid Margin="{StaticResource WindowPageGutter}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <screens:AlbumCarouselView
                            x:Name="Carousel"
                            Covers="{x:Bind Covers}"
                            Filter="{x:Bind State.Selection}"
                            Library="{x:Bind State.Library}" />

                        <screens:AlbumHeaderView
                            x:Name="AlbumHeader"
                            Grid.Row="1"
                            Filter="{x:Bind State.Selection}"
                            Visibility="Collapsed" />

                        <screens:MusicGridView
                            x:Name="MusicGrid"
                            Grid.Row="2"
                            Covers="{x:Bind Covers}"
                            Filter="{x:Bind State.Selection}"
                            Library="{x:Bind State.Library}" />
                    </Grid>
                </SplitView>
            </SplitView>

            <screens:PlayerBarView
                x:Name="PlayerBar"
                Grid.Row="4"
                Margin="{StaticResource WindowPageGutter}"
                Covers="{x:Bind Covers}"
                Playback="{x:Bind State.Playback}" />
        </Grid>

        <screens:PlayView
            x:Name="NowPlaying"
            Covers="{x:Bind Covers}"
            Playback="{x:Bind State.Playback}"
            Visibility="Collapsed" />

        <components:ToastView Toast="{x:Bind State.Toast}" />

        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Done"
            DefaultButton="Close">
            <screens:SettingsView x:Name="Settings" />
        </ContentDialog>
    </Grid>
</Window>
