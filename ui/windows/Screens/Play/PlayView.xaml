<UserControl
    x:Class="Fluyer.Screens.PlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Fluyer.Components"
    xmlns:native="using:Fluyer.Core.Native"
    xmlns:screens="using:Fluyer.Screens">
    <!-- Full-screen now-playing surface. Port of PlayView
         (ui/macos/Sources/Screens/Play/PlayView.swift): cover + control card on
         the left, lyrics scroller on the right when lyrics exist. -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="LyricsColumn" Width="{StaticResource PlayLyricsColumnWidth}" />
        </Grid.ColumnDefinitions>

        <!-- Left column: cover + control card -->
        <StackPanel
            x:Name="LeftStack"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource PlayCoverToControls}">
            <components:CurrentCoverView x:Name="Cover" Side="{StaticResource PlayInitialCoverSide}" Playback="{x:Bind Playback, Mode=OneWay}" Covers="{x:Bind Covers, Mode=OneWay}" />
            <StackPanel x:Name="ControlCard">
                <Grid Margin="{StaticResource PlayControlsInfoMargin}" ColumnSpacing="{StaticResource PlayControlsInfoSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource PlayControlsTimeLabelWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource PlayControlsTimeLabelWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.75"
                        Text="{x:Bind TimeFormatElapsed(Playback.PlayerBar.PositionMs), Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        Opacity="0.9"
                        Text="{x:Bind TrackLabel(Playback.PlayerBar), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Opacity="0.75"
                        Text="{x:Bind TimeFormatElapsed(Playback.PlayerBar.DurationMs), Mode=OneWay}" />
                </Grid>

                <components:SliderTrack
                    x:Name="Progress"
                    Height="{StaticResource PlayControlsSeekHeight}"
                    Fraction="{x:Bind Playback.PlayerBar.ProgressPct, Mode=OneWay}" />

                <StackPanel
                    Margin="{StaticResource PlayControlsTransportMargin}"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource PlayControlsTransportSpacing}">
                    <Button
                        Click="OnCycleRepeat"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Repeat">
                        <FontIcon x:Name="RepeatIcon" FontSize="15" Glyph="&#xE8EE;" />
                    </Button>
                    <Button
                        Click="OnPrevious"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Previous">
                        <FontIcon FontSize="18" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        Click="OnTogglePlay"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Play/Pause">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="24" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Click="OnNext"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Next">
                        <FontIcon FontSize="18" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        Click="OnShuffle"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Shuffle">
                        <FontIcon x:Name="ShuffleIcon" FontSize="15" Glyph="&#xE8B1;" />
                    </Button>
                </StackPanel>

                <Grid Margin="{StaticResource PlayControlsVolumeMargin}" ColumnSpacing="{StaticResource PlayControlsVolumeSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Click="OnToggleMute"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Mute/Unmute">
                        <FontIcon FontSize="13" Glyph="&#xE74F;" />
                    </Button>
                    <components:SliderTrack
                        x:Name="Volume"
                        Grid.Column="1"
                        Height="{StaticResource PlayControlsVolumeSliderHeight}"
                        IsThin="True"
                        Fraction="{x:Bind Playback.PlayerBar.Volume, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Click="OnMaxVolume"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Max volume">
                        <FontIcon x:Name="VolumeIcon" FontSize="13" Glyph="&#xE995;" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Lyrics column. Top/bottom padding lets the first/last lines scroll to
             viewport center. Indicators hidden like Swift's .scrollIndicators(.hidden). -->
        <ListView
            x:Name="Lyrics"
            Grid.Column="1"
            Padding="{StaticResource LyricsPadding}"
            IsItemClickEnabled="True"
            ItemClick="OnLyricClick"
            ItemsSource="{x:Bind Playback.PlayView.Lyrics, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="native:LyricLine">
                    <Grid Margin="{StaticResource LyricsLineMargin}">
                        <!-- Empty (instrumental) lines: Swift's music.note. -->
                        <FontIcon
                            HorizontalAlignment="Left"
                            FontSize="27"
                            Foreground="#FFFFFFFF"
                            Glyph="&#xEC4F;"
                            Opacity="0.5"
                            Visibility="Collapsed" />
                        <TextBlock
                            FontSize="25"
                            FontWeight="Bold"
                            Opacity="0.4"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Back -->
        <Button
            x:Name="BackButton"
            Margin="{StaticResource PlayBackButtonMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="OnBack"
            Style="{StaticResource IconButtonStyle}"
            ToolTipService.ToolTip="Back (Esc)">
            <FontIcon FontSize="13" Glyph="&#xE76B;" />
        </Button>
    </Grid>
</UserControl>
