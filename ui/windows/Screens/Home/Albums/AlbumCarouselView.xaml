<UserControl
    x:Class="Fluyer.Screens.AlbumCarouselView"
    x:Name="CarouselRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native">
    <!-- Horizontal album strip. Port of AlbumCarouselView
         (ui/macos/Sources/Screens/Home/Albums/AlbumCarouselView.swift), including the
         responsive width rules transcribed from AlbumListCtrl. -->
    <UserControl.Resources>
        <StaticResource x:Key="ListViewItemCornerRadius" ResourceKey="AlbumsCardCornerRadius" />
        <!-- SwiftUI AlbumCard draws its own hover chrome; no WinUI item fill. -->
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
    </UserControl.Resources>
    <ListView
        x:Name="Strip"
        Height="{Binding CarouselHeight, ElementName=CarouselRoot}"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind Filter.DisplayedAlbums, Mode=OneWay}"
        PointerCanceled="OnListPointerExited"
        PointerEntered="OnListPointerEntered"
        PointerExited="OnListPointerExited"
        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
        ScrollViewer.HorizontalScrollMode="Enabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        ScrollViewer.VerticalScrollMode="Disabled"
        SelectionMode="None">
        <!-- Same as rows: no entrance replay on ItemsSource/metric resets. -->
        <ListView.ItemContainerTransitions>
            <TransitionCollection />
        </ListView.ItemContainerTransitions>
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="{StaticResource AlbumsItemPadding}" />
                <!-- Gap after each card (code reads it); trailing gap only shows at scroll end. -->
                <Setter Property="Margin" Value="{StaticResource AlbumsItemMargin}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="native:AlbumCardViewModel">
                <StackPanel
                    Width="{Binding CardCoverSize, ElementName=CarouselRoot}"
                    Background="Transparent"
                    PointerCanceled="OnCardPointerExited"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited"
                    Spacing="{StaticResource AlbumsCoverToLabels}">
                    <Grid
                        Width="{Binding CardCoverSize, ElementName=CarouselRoot}"
                        Height="{Binding CardCoverSize, ElementName=CarouselRoot}">
                        <Rectangle Fill="#14FFFFFF" />
                        <FontIcon
                            FontSize="32"
                            Foreground="#4DFFFFFF"
                            Glyph="&#xEC4F;"
                            Tag="art" />
                        <Image x:Name="Cover" Stretch="UniformToFill" Opacity="0" />
                        <!-- AlbumCard.swift: white wash + 2px border on hover,
                             fading in over 0.5s and out over 0.75s. -->
                        <Border
                            x:Name="HoverChrome"
                            Background="#33FFFFFF"
                            BorderBrush="White"
                            BorderThickness="2"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <!-- AlbumCard.swift selection: solid 2px border, no wash. -->
                        <Border
                            x:Name="SelectedChrome"
                            BorderBrush="White"
                            BorderThickness="2"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>
                    <StackPanel Spacing="{StaticResource AlbumsNameToArtist}">
                        <TextBlock
                            FontSize="15"
                            MaxLines="1"
                            Tag="albumtitle"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="13"
                            MaxLines="1"
                            Opacity="0.6"
                            Text="{x:Bind Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
