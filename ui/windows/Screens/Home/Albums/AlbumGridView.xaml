<UserControl
    x:Class="Fluyer.Screens.AlbumGridView"
    x:Name="AlbumGridRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native">
    <!-- Full-height album grid (Albums mode). Port of AlbumGridView
         (ui/macos/Sources/Screens/Home/Albums/AlbumGridView.swift). Same card size
         as the carousel, so switching modes keeps every cover the same size. -->
    <UserControl.Resources>
        <StaticResource x:Key="ListViewItemCornerRadius" ResourceKey="AlbumsCardCornerRadius" />
        <!-- SwiftUI AlbumCard draws its own hover chrome; no WinUI item fill. -->
        <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
        <!-- WinUI dims item text on hover (TextFillColorSecondaryBrush); keep labels white. -->
        <SolidColorBrush x:Key="GridViewItemForegroundPointerOver" Color="White" />
    </UserControl.Resources>
    <Grid>
        <GridView
            x:Name="Cards"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind Filter.DisplayedAlbums, Mode=OneWay}"
            Margin="{StaticResource AlbumsGridMargin}"
            Padding="{StaticResource AlbumsGridPadding}"
            PointerCanceled="OnListPointerExited"
            PointerEntered="OnListPointerEntered"
            PointerExited="OnListPointerExited"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            SelectionMode="None">
            <GridView.ItemContainerTransitions>
                <TransitionCollection />
            </GridView.ItemContainerTransitions>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="{StaticResource AlbumsItemPadding}" />
                    <Setter Property="Margin" Value="{StaticResource AlbumsGridItemMargin}" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="native:AlbumCardViewModel">
                    <StackPanel
                        Width="{Binding CardCoverSize, ElementName=AlbumGridRoot}"
                        Background="Transparent"
                        PointerCanceled="OnCardPointerExited"
                        PointerEntered="OnCardPointerEntered"
                        PointerExited="OnCardPointerExited"
                        Spacing="{StaticResource AlbumsCoverToLabels}">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnPlayAlbum" Tag="{x:Bind Index}" Text="Play" />
                                <MenuFlyoutItem Click="OnQueueAlbum" Tag="{x:Bind Index}" Text="Add to Queue" />
                                <MenuFlyoutItem Click="OnShuffleAlbum" Tag="{x:Bind Index}" Text="Shuffle" />
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <Grid
                            Width="{Binding CardCoverSize, ElementName=AlbumGridRoot}"
                            Height="{Binding CardCoverSize, ElementName=AlbumGridRoot}">
                            <Rectangle Fill="#14FFFFFF" />
                            <FontIcon
                                FontSize="32"
                                Foreground="#4DFFFFFF"
                                Glyph="&#xEC4F;" />
                            <Image x:Name="Cover" Stretch="UniformToFill" Opacity="0" />
                            <!-- AlbumCard.swift: white wash + 2px border on hover,
                                 fading in over 0.5s and out over 0.75s. -->
                            <Border
                                x:Name="HoverChrome"
                                Background="#33FFFFFF"
                                BorderBrush="White"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <!-- AlbumCard.swift selection: solid 2px border, no wash. -->
                            <Border
                                x:Name="SelectedChrome"
                                BorderBrush="White"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                        <StackPanel Spacing="{StaticResource AlbumsNameToArtist}">
                            <TextBlock
                                FontSize="15"
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                MaxLines="1"
                                Opacity="0.6"
                                Text="{x:Bind Artist}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock
            x:Name="EmptyLabel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Opacity="0.5"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
