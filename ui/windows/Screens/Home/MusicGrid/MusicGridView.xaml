<UserControl
    x:Class="Fluyer.Screens.MusicGridView"
    x:Name="MusicGridRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native"
    xmlns:screens="using:Fluyer.Screens">
    <!-- Track rows for the whole library or one album. Port of MusicGridView
         (ui/macos/Sources/Screens/Home/MusicGrid/MusicGridView.swift). -->
    <UserControl.Resources>
        <StaticResource x:Key="ListViewItemCornerRadius" ResourceKey="MusicGridCardCornerRadius" />
    </UserControl.Resources>
    <Grid>
        <!-- Negative right margin cancels the last column's gap so gaps sit only between columns. -->
        <ListView
            x:Name="Rows"
            Margin="{StaticResource MusicGridListMargin}"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind Filter.DisplayedTracks, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollMode="Enabled"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        Orientation="Horizontal"
                        ItemWidth="{Binding CardItemWidth, ElementName=MusicGridRoot}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Padding" Value="{StaticResource MusicGridItemPadding}" />
                    <Setter Property="Margin" Value="{StaticResource MusicGridItemMargin}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="native:TrackItemViewModel">
                    <Grid ColumnSpacing="{StaticResource TrackRowCoverToText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{StaticResource TrackRowCoverSide}" Height="{StaticResource TrackRowCoverSide}">
                            <Rectangle Fill="#14FFFFFF" />
                            <FontIcon
                                FontSize="16"
                                Foreground="#4DFFFFFF"
                                Glyph="&#xEC4F;"
                                Tag="art" />
                            <Image x:Name="Thumb" Stretch="UniformToFill" Opacity="0" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource TrackRowTitleToSubtitle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TrackRowIconToTitle}">
                                <FontIcon
                                    x:Name="NowPlaying"
                                    FontSize="10"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE993;"
                                    Tag="now"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="1"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                FontSize="11"
                                MaxLines="1"
                                Opacity="0.6"
                                Text="{x:Bind screens:MusicGridView.ArtistAlbumLine(Artist, Album)}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="11"
                            Opacity="0.4"
                            Text="{x:Bind DurationFormatted}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="{StaticResource MusicGridEmptyStateSpacing}"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="36"
                Foreground="#33FFFFFF"
                Glyph="&#xEC4F;" />
            <TextBlock
                x:Name="EmptyLabel"
                FontSize="14"
                Opacity="0.5"
                Text="No songs in library" />
            <Button
                x:Name="EmptyAction"
                HorizontalAlignment="Center"
                Click="OnOpenSettings"
                Content="Open Settings"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
