<UserControl
    x:Class="Fluyer.Screens.QueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:native="using:Fluyer.Core.Native"
    xmlns:screens="using:Fluyer.Screens">
    <!-- Right sidebar: play queue. Port of MusicQueueList.svelte; card styling
         matches AlbumHeaderView. -->
    <Border
        Margin="{StaticResource QueueOuterMargin}"
        Padding="{StaticResource QueuePadding}"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        CornerRadius="{StaticResource QueueCornerRadius}">
        <Grid RowSpacing="{StaticResource QueueHeaderToList}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="{StaticResource QueueHeaderSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="{StaticResource QueueTitleMargin}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Queue" />
                <Button
                    x:Name="ClearButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Clear queue"
                    Click="OnClear"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Clear queue">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>
            </Grid>
            <ListView
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                ItemsSource="{x:Bind Queue.Tracks, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="native:TrackItemViewModel">
                        <Grid Padding="{StaticResource QueueRowPadding}" ColumnSpacing="{StaticResource QueueRowTextToButtons}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource QueueRowTitleToArtist}">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="{x:Bind screens:QueueView.RowWeight(IsCurrent)}"
                                    MaxLines="1"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="13"
                                    MaxLines="1"
                                    Opacity="0.6"
                                    Text="{x:Bind Artist}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button
                                    AutomationProperties.Name="Move up"
                                    Click="OnUp"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind Index}"
                                    ToolTipService.ToolTip="Move up">
                                    <FontIcon FontSize="11" Glyph="&#xE70E;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Move down"
                                    Click="OnDown"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind Index}"
                                    ToolTipService.ToolTip="Move down">
                                    <FontIcon FontSize="11" Glyph="&#xE70D;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Remove from queue"
                                    Click="OnRemove"
                                    Style="{StaticResource IconButtonStyle}"
                                    Tag="{x:Bind Index}"
                                    ToolTipService.ToolTip="Remove">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyLabel"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.5"
                Text="Queue is empty" />
        </Grid>
    </Border>
</UserControl>
