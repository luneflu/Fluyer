<UserControl
    x:Class="Fluyer.Screens.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Fluyer.Components"
    xmlns:screens="using:Fluyer.Screens">
    <!-- Always-visible transport strip. Port of PlayerBarView
         (ui/macos/Sources/Screens/Home/PlayerBar/PlayerBarView.swift). -->
    <StackPanel Spacing="{StaticResource PlayerBarSeekToControls}">
        <components:SliderTrack
            x:Name="SeekBar"
            Height="{StaticResource PlayerBarSeekHeight}"
            Fraction="{x:Bind Playback.PlayerBar.ProgressPct, Mode=OneWay}" />

        <Border
            Margin="{StaticResource PlayerBarControlsMargin}"
            Padding="{StaticResource PlayerBarControlsPadding}"
            Background="#14FFFFFF"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="{StaticResource PlayerBarCornerRadius}">
            <Grid Height="{StaticResource PlayerBarControlsHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource PlayerBarSideColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource PlayerBarSideColumnWidth}" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="{StaticResource PlayerBarTransportSpacing}">
                    <Button
                        AutomationProperties.Name="Previous"
                        Click="OnPrevious"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Previous">
                        <FontIcon FontSize="15" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Play/Pause"
                        Click="OnTogglePlay"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Play/Pause">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="17" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Next"
                        Click="OnNext"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Next">
                        <FontIcon FontSize="15" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="{StaticResource PlayerBarCoverToText}">
                    <Button
                        Click="OnOpenNowPlaying"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Open Now Playing">
                        <components:CurrentCoverView Side="{StaticResource PlayerBarCoverSide}" Playback="{x:Bind Playback, Mode=OneWay}" Covers="{x:Bind Covers, Mode=OneWay}" />
                    </Button>
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource PlayerBarTitleToArtist}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind Playback.PlayerBar.Title, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            MaxLines="1"
                            Opacity="0.6"
                            Text="{x:Bind Playback.PlayerBar.Artist, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource PlayerBarSecondarySpacing}">
                    <Button
                        x:Name="QueueButton"
                        AutomationProperties.Name="Queue"
                        Click="OnQueue"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Queue (Ctrl+L)">
                        <FontIcon FontSize="13" Glyph="&#xE90B;" />
                    </Button>
                    <Button
                        Click="OnCycleRepeat"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Repeat">
                        <FontIcon x:Name="RepeatIcon" FontSize="13" Glyph="&#xE8EE;" />
                    </Button>
                    <Button
                        Click="OnShuffle"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Shuffle">
                        <FontIcon x:Name="ShuffleIcon" FontSize="13" Glyph="&#xE8B1;" />
                    </Button>
                    <Button
                        Click="OnToggleMute"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Mute/Unmute">
                        <FontIcon x:Name="VolumeIcon" FontSize="13" Glyph="&#xE995;" />
                    </Button>
                    <components:SliderTrack
                        x:Name="VolumeBar"
                        Width="{StaticResource PlayerBarVolumeSliderWidth}"
                        Height="{StaticResource PlayerBarVolumeSliderHeight}"
                        IsThin="True"
                        Fraction="{x:Bind Playback.PlayerBar.Volume, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
