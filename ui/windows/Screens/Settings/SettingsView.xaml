<UserControl
    x:Class="Fluyer.Screens.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings dialog body: music folders + persisted toggles.
         Port of SettingsView (ui/macos/Sources/Screens/Settings/SettingsView.swift). -->
    <StackPanel Width="{StaticResource SettingsWidth}" Spacing="{StaticResource SettingsSectionSpacing}">
        <StackPanel Spacing="{StaticResource SettingsRowSpacing}">
            <TextBlock FontWeight="SemiBold" Text="Music folders" />
            <ListView
                x:Name="FolderList"
                MaxHeight="{StaticResource SettingsFolderListMaxHeight}"
                ItemsSource="{x:Bind State.Settings.MusicFolders, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="{StaticResource SettingsRowSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind}" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Remove folder"
                                Click="OnRemoveFolder"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Remove folder and its songs">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="NoFolders"
                Opacity="0.6"
                Text="No folders yet."
                Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SettingsRowSpacing}">
                <Button Click="OnAddFolder" Content="Add folder..." />
                <Button x:Name="RescanButton" Click="OnRescan" Content="Rescan" />
            </StackPanel>
        </StackPanel>
        <ToggleSwitch
            Header="Animated background"
            IsOn="{x:Bind State.Settings.AnimatedBackground, Mode=TwoWay}" />
        <ToggleSwitch
            Header="Discord Rich Presence"
            IsOn="{x:Bind State.Settings.DiscordRpc, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
